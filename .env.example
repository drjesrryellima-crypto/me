# --- Meta / WhatsApp Business Cloud API ---
WHATSAPP_TOKEN=coloque_aqui_o_token_de_acesso_permanente
WHATSAPP_PHONE_NUMBER_ID=coloque_aqui_o_phone_number_id
WHATSAPP_VERIFY_TOKEN=escolha_uma_senha_qualquer_para_o_webhook
GRAPH_API_VERSION=v20.0

# App Secret do app na Meta (developers.facebook.com -> seu app -> Configuracoes -> Basico).
# Com isso definido, o servidor so aceita POST assinado pela Meta. Sem isso, o
# webhook aceita POST de QUALQUER origem: da pra forjar um lead ou um falso
# alerta de crise. Obrigatorio antes de expor o endereco (ngrok ou VPS).
WHATSAPP_APP_SECRET=

# --- Templates de follow-up (obrigatório fora da janela de 24h — ver README) ---
# Nome de cada template pré-aprovado no Meta Business Manager. Os follow-ups
# D+2/D+3/D+5/D+7 ficam pulados (com aviso no log) enquanto a variável
# correspondente não for preenchida.
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_D2=
WHATSAPP_TEMPLATE_D3=
WHATSAPP_TEMPLATE_D5=
WHATSAPP_TEMPLATE_D7=

# --- Assistente com IA (Claude API) ---
# Sem a chave, o bot responde so pelo roteiro fixo (funciona, mas trava quando o
# lead foge do script). Pegue em console.anthropic.com.
ANTHROPIC_API_KEY=
# Opcional: troca o modelo. Padrao claude-opus-5.
CLAUDE_MODEL=
# Coloque "off" pra desligar a IA sem remover a chave (util pra comparar).
ASSISTENTE_IA=

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json
# Em servidor (Railway/Render) nao da pra por arquivo la dentro, so variavel.
# Entao cole aqui o CONTEUDO do JSON (cru ou em base64) e deixe a de cima
# vazia. No Mac, ignore esta: o arquivo acima ja resolve.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
# ID da planilha CRM_Leads_Dr_Jesrryel - OFICIAL
GOOGLE_SHEET_ID=1FN00DcZW17pruFRsyxDHWijtcSifQVj3PrSbRiHyMQg
# Nome EXATO da aba onde o bot grava. Precisa ser uma aba so dele: as outras
# abas tem o telefone em outra coluna e o upsert procura na coluna A.
GOOGLE_SHEET_TAB=Leads Bot

# --- Alerta de crise e de handoff ---
# Sem nenhum destes, o alerta so aparece no log do servidor — e ninguem e
# avisado de verdade quando um paciente sinaliza risco.
#
# Telegram: crie um bot conversando com o @BotFather (comando /newbot) e cole o
# token aqui. Depois mande qualquer mensagem para o seu bot uma vez: ele
# descobre sozinho para onde mandar os alertas, e guarda.
TELEGRAM_BOT_TOKEN=
# Opcional. So se quiser fixar o destino em vez de deixar o bot descobrir.
TELEGRAM_CHAT_ID=

# Opcional, em paralelo ao Telegram (ex: webhook do Slack ou do Zapier).
HANDOFF_ALERT_WEBHOOK_URL=

# --- Dashboard de leads ---
# OBRIGATÓRIO pra o painel /dashboard funcionar. Escolha uma senha longa e
# aleatória: o painel mostra telefone e o motivo que cada lead contou, e o
# ngrok deixa essa URL pública. Sem isso definido, o /dashboard fica desligado.
DASHBOARD_TOKEN=

# --- Servidor ---
PORT=3000

# Onde os dados ficam em disco. Local, deixe vazio (usa ./data).
# Em servidor (Railway/Render), o disco e EFEMERO: aponte para um volume
# persistente ou TODO DEPLOY apaga os leads e o historico das conversas.
DATA_DIR=

# --- Follow-up ---
# Servidor em nuvem roda em UTC. Sem isso, "09:00" vira 06:00 em Mossoro e o
# lead recebe o follow-up de madrugada.
FOLLOWUP_TIMEZONE=America/Fortaleza
FOLLOWUP_HORA=9
