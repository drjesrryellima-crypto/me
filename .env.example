# --- Meta / WhatsApp Business Cloud API ---
WHATSAPP_TOKEN=coloque_aqui_o_token_de_acesso_permanente
WHATSAPP_PHONE_NUMBER_ID=coloque_aqui_o_phone_number_id
WHATSAPP_VERIFY_TOKEN=escolha_uma_senha_qualquer_para_o_webhook
GRAPH_API_VERSION=v20.0

# App Secret do app na Meta (developers.facebook.com -> seu app -> Configuracoes -> Basico).
# Com isso definido, o servidor so aceita POST assinado pela Meta. Sem isso, o
# webhook aceita POST de QUALQUER origem: da pra forjar um lead ou um falso
# alerta de crise. Obrigatorio antes de expor o endereco (ngrok ou VPS).
WHATSAPP_APP_SECRET=

# --- Templates de follow-up (obrigatório fora da janela de 24h — ver README) ---
# Nome de cada template pré-aprovado no Meta Business Manager. Os follow-ups
# D+2/D+3/D+5/D+7 ficam pulados (com aviso no log) enquanto a variável
# correspondente não for preenchida.
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_D2=
WHATSAPP_TEMPLATE_D3=
WHATSAPP_TEMPLATE_D5=
WHATSAPP_TEMPLATE_D7=

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json
GOOGLE_SHEET_ID=coloque_aqui_o_id_da_planilha
GOOGLE_SHEET_TAB=Leads

# --- Alerta de handoff (opcional, ex: webhook do Slack/Zapier) ---
HANDOFF_ALERT_WEBHOOK_URL=

# --- Dashboard de leads ---
# OBRIGATÓRIO pra o painel /dashboard funcionar. Escolha uma senha longa e
# aleatória: o painel mostra telefone e o motivo que cada lead contou, e o
# ngrok deixa essa URL pública. Sem isso definido, o /dashboard fica desligado.
DASHBOARD_TOKEN=

# --- Servidor ---
PORT=3000
